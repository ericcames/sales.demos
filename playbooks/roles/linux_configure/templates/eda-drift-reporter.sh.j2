#!/bin/bash
# Managed by Ansible — linux_configure role (#696).
#
# audisp dispatcher: filter for MAC_STATUS enforcing=0 (SELinux switched to
# permissive) and POST to the EDA webhook. enforcing=1 is remediation
# restoring the correct state, not drift — skip it.
#
# Runs as a child of auditd. Reads audit events on stdin, one per line.
# curl runs in background with --max-time so it never blocks auditd.

while read -r line; do
  case "$line" in
    *type=MAC_STATUS*enforcing=0*)
      curl -s --max-time 5 -X POST \
        -H "Content-Type: application/json" \
        -d "{\"has_investigate\": true, \"host\": \"$(hostname -f)\"}" \
        "{{ linux_configure_eda_webhook_url }}" &
      ;;
  esac
done
