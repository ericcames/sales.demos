{# ==========================================================================
   The demo page.

   SELF-CONTAINED ON PURPOSE: no CDN, no webfonts, and the logos are served
   from this host rather than fetched from redhat.com. It is displayed from a
   VM on a cluster whose egress you do not control, in front of a customer —
   anything fetched at render time is a blank box waiting to happen.

   Every value comes from the guest's own facts or from variables the
   provisioning run already set, so the page proves the chain it describes
   rather than asserting it.

   American spelling throughout — this is a US-facing sales demo.
   ========================================================================== #}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ inventory_hostname_short }} — sales.demos</title>
<style>
  :root { color-scheme: light dark; }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 2.5rem 1.5rem;
    font: 16px/1.6 "Red Hat Text", system-ui, -apple-system, sans-serif;
    background: #f4f4f4; color: #151515;
    display: flex; justify-content: center;
  }
  @media (prefers-color-scheme: dark) {
    body { background: #151515; color: #e0e0e0; }
    .card { background: #1f1f1f !important; border-color: #3d3d3d !important; }
    td { border-color: #3d3d3d !important; }
    .k { color: #a0a0a0 !important; }
    h1 { color: #e0e0e0 !important; }
  }
  .wrap { width: 100%; max-width: 48rem; }

  /* Headline ABOVE the rule: it is the point of the demo, not a caption. */
  h1 {
    margin: 0 0 1rem; font-size: 1.5rem; line-height: 1.35;
    font-weight: 700; color: #151515;
  }
  .bar { height: 4px; background: #ee0000; border-radius: 2px; margin-bottom: 1.5rem; }

  .host { margin: 0 0 1.25rem; font-size: 1.05rem; font-weight: 600; }
  .host .dot {
    display: inline-block; width: .6rem; height: .6rem; border-radius: 50%;
    background: #3e8635; margin-right: .55rem; vertical-align: middle;
  }
  .card {
    background: #fff; border: 1px solid #d2d2d2; border-radius: .4rem;
    padding: 1.25rem 1.5rem; margin-bottom: 1rem;
  }
  table { width: 100%; border-collapse: collapse; }
  td { padding: .5rem 0; border-bottom: 1px solid #ebebeb; vertical-align: top; }
  tr:last-child td { border-bottom: 0; }
  .k { width: 12rem; color: #6a6e73; }
  .v { font-family: "Red Hat Mono", ui-monospace, SFMono-Regular, monospace; word-break: break-all; }

  /* Dark band so the three reverse-variant (white) marks read as one lockup. */
  .logos {
    background: #151515; border-radius: .4rem;
    padding: 1.5rem; margin-bottom: 1rem;
    display: flex; flex-wrap: wrap; gap: 2rem;
    align-items: center; justify-content: center;
  }
  .logos img { height: 2.1rem; width: auto; max-width: 100%; }

  .notice {
    border-left: 4px solid #f0ab00; background: #fdf7e7; color: #3d2c00;
    padding: .9rem 1.1rem; border-radius: .25rem; margin-bottom: 1rem;
  }
  @media (prefers-color-scheme: dark) {
    .notice { background: #232323; color: #f0ab00; }
  }
  .notice strong { display: block; margin-bottom: .15rem; }
  footer { color: #6a6e73; font-size: .85rem; text-align: center; margin-top: 1.5rem; }
  footer a { color: #06c; text-decoration: none; }
  footer a:hover { text-decoration: underline; }
  @media (prefers-color-scheme: dark) { footer a { color: #73bcf7; } }
  .notice { margin-top: 1.5rem; }
</style>
</head>
<body>
<div class="wrap">

  <div class="logos">
    <img src="logos/rhel.svg" alt="Red Hat Enterprise Linux">
    <img src="logos/openshift.svg" alt="Red Hat OpenShift">
    <img src="logos/aap.svg" alt="Red Hat Ansible Automation Platform">
  </div>

  <h1>{{ linux_configure_message }}</h1>
  <div class="bar"></div>

  <p class="host"><span class="dot"></span>{{ inventory_hostname_short }}</p>

  <div class="card">
    <table>
      <tr><td class="k">Operating system</td><td class="v">{{ ansible_distribution }} {{ ansible_distribution_version }}</td></tr>
      <tr><td class="k">Kernel</td><td class="v">{{ ansible_kernel }}</td></tr>
      <tr><td class="k">Size tier</td><td class="v">{{ vm_size_tier | default('n/a') }}{% if vm_size_chosen is defined %} &rarr; {{ vm_size_chosen }}{% endif %}</td></tr>
      <tr><td class="k">vCPU / memory</td><td class="v">{{ ansible_processor_vcpus }} vCPU &middot; {{ ansible_memtotal_mb }} MB</td></tr>
      {# On a KubeVirt guest these facts come back as the literal string "NA",
         which is defined and so keeps `| default()` from firing — it rendered
         "NA (NA)" until that was caught. The normalisation now lives in the
         role's vars/main.yml so facts.json reports the SAME values this shows;
         it used to be here only, and the two disagreed on a live VM (#160). #}
      <tr><td class="k">Virtualization</td><td class="v">
        {{- linux_configure_virt_type }} ({{ linux_configure_virt_role -}})
      </td></tr>
      <tr><td class="k">In-cluster address</td><td class="v">{{ ansible_host | default(inventory_hostname) }}</td></tr>
      <tr><td class="k">Configured</td><td class="v">{{ ansible_date_time.iso8601 }}</td></tr>
    </table>
  </div>

{% if linux_configure_golden_image_source | default('') | length > 0 %}
  <div class="card">
    <table>
      <tr><td class="k">Golden image</td><td class="v">{{ linux_configure_golden_image_repo }}</td></tr>
      <tr><td class="k">Build date</td><td class="v">{{ linux_configure_golden_image_build_date }}</td></tr>
{% if linux_configure_golden_image_cis_level | default('') | length > 0 %}
      <tr><td class="k">CIS profile</td><td class="v">Level {{ linux_configure_golden_image_cis_level }} Server</td></tr>
{% endif %}
      <tr><td class="k">Pipeline</td><td class="v"><a href="{{ linux_configure_golden_image_pipeline_url }}">{{ linux_configure_golden_image_pipeline_url | replace('https://', '') }}</a></td></tr>
      <tr><td class="k">Compliance</td><td class="v"><a href="compliance/report.html">CIS Level {{ linux_configure_golden_image_cis_level }} scan report</a></td></tr>
    </table>
  </div>
{% endif %}

  <div class="notice">
    <strong>This VM is temporary.</strong>
    It is decommissioned automatically at {{ linux_configure_teardown_time }} by a
    scheduled job in Ansible Automation Platform, along with everything on it.
  </div>

  <footer>
    Provisioned by Terraform on Red Hat OpenShift Virtualization &middot;
    configured by Red Hat Ansible Automation Platform<br>
    {# The close for a technical audience: everything on this page is
       inspectable. The repository is public and holds no customer data. #}
    <a href="{{ linux_configure_repo_url }}">{{ linux_configure_repo_url | replace('https://', '') }}</a>
  </footer>
</div>
</body>
</html>
