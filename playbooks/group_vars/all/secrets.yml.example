---
# ===========================================================================
# secrets.yml.example — the shape of playbooks/group_vars/all/secrets.yml.
# ===========================================================================
#
# This is the repo's ONLY .example file. Its whole job is to show what the
# real file must contain.
#
# The real file is VAULT-ENCRYPTED AND LOCAL ONLY — it is not tracked (#130).
# On a fresh clone it does not exist and you build it from this file, choosing
# your own vault password:
#
#     cp playbooks/group_vars/all/secrets.yml.example \
#        playbooks/group_vars/all/secrets.yml
#     # fill in real values, then:
#     ansible-vault encrypt playbooks/group_vars/all/secrets.yml \
#       --vault-id sales.demos@~/secrets/.vault_pass_sales_demos
#
# To change a value in the existing file:
#
#     ansible-vault edit playbooks/group_vars/all/secrets.yml \
#       --vault-id sales.demos@~/secrets/.vault_pass_sales_demos
#
# ONE FILE, BOTH ENVIRONMENTS. It sits in the `all` group directory beside the
# PLAYBOOKS, so it loads for sandbox and demo alike — and for the demo VMs,
# which is why `all` and not `aap` (#5). Values that differ per environment are
# keyed under env_secrets; connection.yml selects with env_secrets[aap_env_name].
#
# CREDENTIALS ONLY. Hostnames, API URLs, usernames, and namespaces are not
# secret and live in the committed plaintext group_vars/<env>/connection.yml.
# A new RHDP environment means editing that env's connection.yml plus the two
# credential keys below.
#
# NEVER commit the real file at all. utilities/check-no-secrets.sh fails the
# build if anything named secrets.yml is tracked, if the .gitignore rule that
# keeps it untracked stops matching, or if a tracked one is not encrypted.
#
# EVERY KEY THE CODE READS MUST APPEAR HERE. utilities/check-secrets-example.sh
# greps the tree for consumed keys and fails CI if one is missing, because this
# file is the only contract a new user has and it had already drifted: the two
# rhsm_* keys below are asserted by playbooks/roles/linux_register and were
# absent here, so a secrets file built from this example passed every preflight
# and then failed Phase 4 on guest registration. (#128)
# ===========================================================================

# --- Per-environment credentials -------------------------------------------
# From the RHDP provisioning email (aap_password) and the OpenShift console's
# "Copy login command" (openshift_api_token). RHDP tokens are short-lived —
# expect to refresh these more often than anything else here.
env_secrets:
  sandbox:
    aap_password: "CHANGEME"
    openshift_api_token: "sha256~CHANGEME"
    linux_admin_password: "CHANGEME"
  demo:
    aap_password: "CHANGEME"
    openshift_api_token: "sha256~CHANGEME"
    linux_admin_password: "CHANGEME"

# --- NOT HERE: automation_hub_token ----------------------------------------
# ~/.ansible.cfg already holds it and is the authoritative copy, so
# group_vars/aap/main.yml reads it from there with an ini lookup rather than
# keeping a second copy that goes stale on rotation. Nothing to fill in. (#22)
#
# THIS IS THE RED HAT OFFLINE TOKEN, from
# https://console.redhat.com/ansible/automation-hub/token — and it is also what
# Private Automation Hub presents to console.redhat.com to sync its
# rh-certified and validated repositories (#68). One token, one place.
#
# A vaulted fallback for the AAP execution environment was built, verified, and
# then deliberately removed: it bought one job template at the cost of a second
# copy of a rotating credential. PAH work runs from a laptop instead. See the
# comment in group_vars/aap/main.yml.
#
# TWO OTHER THINGS ARE ALSO CALLED "TOKEN" and are likewise not here:
#   - your PAH's own API token — per-user and short-lived; ansible.hub uses
#     ah_username/ah_password instead, which are already covered above
#   - a galaxy.ansible.com token — only needed to PUBLISH; reading public
#     community collections is anonymous
# The full table is in docs/demos/private-automation-hub/architecture.md.

# --- Automation Analytics service account (yours, not the environment's) ---
# REQUIRED. group_vars/aap/controller_settings.yml references both and loads
# for every environment, so an AAP apply fails with an undefined-variable
# error if either is missing. Red Hat service account credentials from
# console.redhat.com — AAP never returns them through the API, so they cannot
# be recovered from a running instance.
#
# CHANGEME lets an apply succeed (only the upload fails); blank breaks it.
vaulted_subscriptions_client_id: "CHANGEME"
vaulted_subscriptions_client_secret: "CHANGEME"

# --- Red Hat subscription registration (Phase 4) ---------------------------
# REQUIRED for the demo content. playbooks/roles/linux_register asserts BOTH
# and fails the play if either is empty:
#
#     rhsm_org_id and rhsm_activation_key are required to register the guest.
#
# This is not optional polish. The RHEL guest ships with NO package repos, so
# registration is the first thing that must succeed — the web server install,
# and therefore the whole demo URL, is downstream of it.
#
# Both come from https://console.redhat.com/insights/connector/activation-keys
#   rhsm_org_id          your Red Hat org ID (numeric, shown on that page)
#   rhsm_activation_key  the activation key NAME, not a token
#
# /ocpvirt-demo preflights for rhsm_activation_key before it launches anything,
# so a missing key fails fast rather than half-way through a demo.
rhsm_org_id: "CHANGEME"
rhsm_activation_key: "CHANGEME"

# --- Quay.io (private repo holding the Windows golden containerdisk) -------
# CONSUMED by playbooks/link_windows_image.yml (#3). The playbook asserts both
# keys bare, so a missing or CHANGEME value fails the preflight.
#
# Must be a PRIVATE repo — a Windows image cannot be redistributed publicly.
# See docs/plan/ocpvirt-demo-plan.md.
quay_username: "CHANGEME"
quay_password: "CHANGEME"

# --- Demo VM credentials ---------------------------------------------------
# linux_admin_password lives in env_secrets above. It is consumed by
# provision_vm.yml TWICE: to set a password on the RHEL guest for Cockpit login
# (#63), and — since #201 — as the Windows password too, via the sysprep
# unattend that terraform/ocpvirt builds for the cloned Windows guest.
#
# THERE IS NO windows_admin_password KEY, and that is the point of #201. It used
# to be declared here and read by nothing. The password Windows actually boots
# with was baked into the golden image at build time, which meant it had to be
# ONE GLOBAL VALUE for an image both environments pull — irreconcilable with a
# per-environment credential. image.builder.pipeline now bakes in a random string
# it throws away, and the real password is set on the clone instead. One password
# to remember per environment, and it is the Linux one.
#
# WATCH THE LENGTH. Windows enforces complexity on a local administrator account,
# and CIS L1 for Windows Server 2022 requires a 14-character minimum. The current
# 8-character values predate Windows using this key at all and will be REJECTED
# once the CIS-hardened Windows image lands. Lengthen both environments before
# then, not after.

# --- Demo VM SSH private key -----------------------------------------------
# The PRIVATE half of demo_ssh_public_key, which is committed in plaintext in
# each group_vars/<env>/connection.yml. Feeds the "Sales Demos - Linux Machine"
# credential so AAP can run playbooks against the provisioned VMs.
#
# ONE KEY, BOTH ENVIRONMENTS, and it must stay in step with the public half in
# BOTH connection.yml files. Change one, change all three.
#
# AAP reaches the VMs directly over cluster DNS on port 22 — it runs on the same
# cluster — so this key is the whole authentication story. There is no bastion,
# and the execution environment has no virtctl.
#
# Paste the full private key under the block scalar, indented two spaces,
# INCLUDING its BEGIN and END lines. They are not written out here on purpose:
# utilities/check-no-secrets.sh fails the build on a private-key block in any
# tracked file, and this file is tracked. A placeholder that trips the guard
# would train people to ignore it.
# --- Grafana Cloud (vendor-hosted observability) --------------------------
# CONSUMED by utilities/make-grafana-mcp.sh (#260). The script asserts both
# keys non-empty, so a missing or CHANGEME value fails the preflight.
#
# These are TOP-LEVEL keys, not under env_secrets, because Grafana Cloud is a
# single external instance that spans both environments — it survives RHDP
# rebuilds, which is the whole point of choosing it over self-hosted.
#
# grafana_cloud_url   your Grafana Cloud stack URL (e.g. https://<org>.grafana.net)
# grafana_cloud_sa_token  a service account token with the Viewer role
#                         (Administration > Service Accounts > Add > Viewer > Add token)
#
# THE URL IS SENSITIVE — it contains the org slug. By the Dynatrace precedent
# (#99 S3), vendor-specific SaaS URLs are treated as credentials here.
grafana_cloud_url: "CHANGEME"
grafana_cloud_sa_token: "CHANGEME"

# --- Grafana Cloud push credentials (Phase 1, #265) ----------------------
# CONSUMED by playbooks/deploy_alloy.yml. These are WRITE credentials —
# separate from the Viewer SA token above, which is for MCP reads only.
#
# Created as a Cloud Access Policy token with metrics:write + logs:push scopes.
# See docs/plan/grafana-plan.md → Phase 1.
#
# How to generate:
#   1. grafana.com → Security → Access Policies → Create
#   2. Scopes: metrics:write, logs:write
#   3. Generate a token (glc_...)
#   4. Stack → Prometheus → Details → remote-write URL + username
#   5. Stack → Loki → Details → push URL + username
grafana_cloud_prom_push_url: "CHANGEME"
grafana_cloud_prom_username: "CHANGEME"
grafana_cloud_loki_push_url: "CHANGEME"
grafana_cloud_loki_username: "CHANGEME"
grafana_cloud_push_api_key: "CHANGEME"

# --- Grafana Cloud dashboard push (Phase 2/3, #275) -------------------------
# CONSUMED by playbooks/deploy_dashboard.yml. A separate service account with
# the Editor role — the Viewer SA above stays for MCP reads. The governance
# thesis (MCP reads, Ansible writes) is a demo talking point, so the tokens
# stay separate.
#
# How to create:
#   1. Grafana Cloud → Administration → Service Accounts → Add
#   2. Name: "sales-demos-editor", Role: Editor
#   3. Add token → copy the glsa_... value here
grafana_cloud_editor_sa_token: "CHANGEME"

demo_ssh_private_key: |
  CHANGEME
