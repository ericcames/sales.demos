---
# yamllint config for sales.demos (CI lint gate).
# Codifies the standard .github/workflows/lint.yml enforces.
extends: default

ignore: |
  collections/ansible_collections/
  # secrets.yml is vault-encrypted ciphertext, which is not YAML. It moved to
  # playbooks/group_vars/ so the AAP inventory sync can parse inventory/ without
  # a vault password — see CLAUDE.md.
  playbooks/group_vars/*/secrets.yml

rules:
  # Kubernetes/KubeVirt manifests and long env-var lookups run past 80. Keep
  # readability without hard-wrapping — warn, don't fail.
  line-length:
    max: 200
    level: warning
  truthy:
    allowed-values: ["true", "false", "yes", "no"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  # Kept aligned with ansible-lint's embedded yamllint so the two don't disagree.
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  # The generated hub/*-requirements.yml end WITHOUT a trailing newline, and
  # that is load-bearing rather than sloppy generation (#68).
  #
  # ansible.hub sends each file's contents verbatim as a collection remote's
  # requirements_file, and Pulp stores it with the trailing newline stripped.
  # Keep the newline and the module compares what it would send against what is
  # stored, finds they differ by that one character, and rewrites all three
  # remotes on every single run — so the config-as-code demo can never show
  # changed=0, which is the entire claim it makes.
  #
  # Scoped to hub/ deliberately. Every other file in the repo still has to end
  # with a newline; utilities/refresh-hub-requirements.py carries the same note.
  new-line-at-end-of-file:
    ignore: |
      hub/
