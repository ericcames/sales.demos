---
# ===========================================================================
# local.yml — laptop-only override for pointing demo at YOUR cluster.
# ===========================================================================
#
# Copy this file to local.yml in the same directory and fill in your values:
#
#     cp local.yml.example local.yml
#
# local.yml is gitignored — it never conflicts with upstream and never
# appears in an AAP SCM checkout.  Ansible loads group_vars files in sorted
# order; local.yml ('l' > 'c') wins over connection.yml.
#
# THE NAME MUST BE local.yml.  "connection.local.yml" sorts BEFORE
# "connection.yml" and loses silently.
#
# You also need credentials in playbooks/group_vars/all/secrets.yml (build
# it from secrets.yml.example): aap_password and kubeadmin_password for this
# environment.  `bash utilities/set-env-passwords.sh <env>` writes both
# without echoing them.  openshift_api_token is derived from
# kubeadmin_password by utilities/derive-ocp-token.sh — never pasted (#559).
#
# AAP sees these values too, with no commit.  local.yml is absent from AAP's
# SCM checkout, but config.yml runs on the laptop, resolves the effective
# values (this file wins) and writes them into the AAP inventory as host
# variables, which job templates read.  Committing connection.yml
# (utilities/update-connection.sh) only refreshes the upstream reference
# that fresh clones start from.

aap_hostname: "aap-aap.apps.cluster-<id>.dyn.redhatworkshops.io"
openshift_api_url: "https://api.cluster-<id>.dyn.redhatworkshops.io:6443"
openshift_apps_domain: "apps.cluster-<id>.dyn.redhatworkshops.io"

# SSH public key injected into demo VMs by cloud-init. Without this, the VM
# is unreachable — cloud-init disables password auth with no authorized key.
# The matching private half goes in secrets.yml as demo_ssh_private_key.
demo_ssh_public_key: "ssh-rsa CHANGEME"

# LiteMaaS (#825) — the URL and model are committed in
# inventory/group_vars/aap/litemaas.yml, so nothing is needed here. Override
# only to try another model, or set litemaas_url: "" to opt this environment
# out. The key goes in secrets.yml as litemaas_api_key.
# litemaas_model: "llama-scout-17b"

# Policy as Code change window (#841) — committed in
# inventory/group_vars/aap/opa_policy.yml. Set it to YOUR zone if you present
# the demo: the window is "weekends only" there, and a zone already past
# Friday midnight lets `Policy as Code - Change Window` run on screen.
# policy_change_window_timezone: "America/Los_Angeles"
