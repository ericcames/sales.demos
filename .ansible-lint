---
# ansible-lint config for the CI lint gate (.github/workflows/lint.yml).
# CI runs offline with no Automation Hub token, so the certified collections in
# collections/requirements.yml are NOT installed there. Declare the modules and
# roles the playbooks call from them, otherwise syntax-check fails with
# "couldn't resolve module/action". Locally they resolve because the collections
# are installed; CI is the clean case these mocks cover.
offline: true
profile: basic

# Keep ansible-lint's verdict on line length in step with .yamllint, which sets
# `line-length: {max: 200, level: warning}` — "warn, don't fail" — but only for
# its own runs. ansible-lint re-reports the same finding as an ERROR, so without
# this the two tools disagree and CI fails on something the repo has already
# decided is acceptable.
#
# What forced the issue: an SSH public key is a single 575-character token.
# demo_ssh_public_key in each group_vars/<env>/connection.yml cannot be wrapped
# — YAML escaped continuations would round-trip today, but a later reflow would
# corrupt the base64 silently and the failure would surface as an SSH auth error
# nowhere near the cause. Better a long line than a bomb.
warn_list:
  - yaml[line-length]

mock_modules:
  # Platform gateway — token lifecycle. Any playbook creating a token must
  # delete it in an `always:` block.
  - ansible.platform.token
  # Raw Kubernetes objects — the CNV install (Phase 0, playbooks/install_cnv.yml)
  # creates the Subscription and HyperConverged CR with these.
  - kubernetes.core.k8s
  - kubernetes.core.k8s_info
  # OpenShift Virtualization — VM lifecycle (Phases 1-4).
  - redhat.openshift_virtualization.kubevirt_vm
  - redhat.openshift_virtualization.kubevirt_vm_info
  # AAP inventory membership — playbooks/provision_vm.yml registers the VMs it
  # creates. These are ansible.controller rather than ansible.platform, which is
  # NOT an oversight: ansible.platform ships no host, group, or inventory
  # module. Inventory membership is still controller-scoped in AAP 2.6.
  - ansible.controller.inventory
  - ansible.controller.group
  - ansible.controller.host

mock_roles:
  - infra.aap_configuration.dispatch

exclude_paths:
  - collections/ansible_collections/
  - .github/
